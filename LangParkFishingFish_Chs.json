[
    {
        "id": "la-park_fishing_fish-0001-description",
        "data": {
            "id": "la-park_fishing_fish-0001-description",
            "text": "别称“七星鱼”，是海中的多面手。难以想象它小小的身体竟能爆发出如此浓烈的鲜味，与咸甜酱汁堪称绝配。今夜就来细细品尝钓上这海中七星的幸运吧！"
        }
    },
    {
        "id": "la-park_fishing_fish-0001-name",
        "data": {
            "id": "la-park_fishing_fish-0001-name",
            "text": "沙瑙鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0002-description",
        "data": {
            "id": "la-park_fishing_fish-0002-description",
            "text": "每长大一个阶段就会换一个名字做头衔，是个上进心很强的家伙。体长超过50厘米的巨型竹䇲鱼只要上火一烤，油脂的香气会直击你的食欲！抓住你的胃，就再也不放手了。"
        }
    },
    {
        "id": "la-park_fishing_fish-0002-name",
        "data": {
            "id": "la-park_fishing_fish-0002-name",
            "text": "竹䇲鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0003-description",
        "data": {
            "id": "la-park_fishing_fish-0003-description",
            "text": "楚楚动人的身姿为它带来了“海滩贵妇”的雅称。反差的是，咬钩时它强劲的拉扯会唤起渔夫的狩猎本能。炸成天妇罗后，外脆里嫩的鱼肉入口即化，简直一绝！"
        }
    },
    {
        "id": "la-park_fishing_fish-0003-name",
        "data": {
            "id": "la-park_fishing_fish-0003-name",
            "text": "沙尖鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0004-description",
        "data": {
            "id": "la-park_fishing_fish-0004-description",
            "text": "它会当着钓师的面明晃晃地偷走钩上的鱼饵，是海中第一戏法高手。但只要来上一口它蘸满鱼肝酱油的绝品刺身，再大的不甘也会烟消云散！偷饵贼和钓师们的智慧较量，火热爆发中！"
        }
    },
    {
        "id": "la-park_fishing_fish-0004-name",
        "data": {
            "id": "la-park_fishing_fish-0004-name",
            "text": "剥皮鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0005-description",
        "data": {
            "id": "la-park_fishing_fish-0005-description",
            "text": "总是气鼓鼓的，看着就治愈人心。但如果让不懂行的新手来料理它，可是会吃成断头饭的！只有持证上岗的大师傅才能驾驭这道禁忌的美味。"
        }
    },
    {
        "id": "la-park_fishing_fish-0005-name",
        "data": {
            "id": "la-park_fishing_fish-0005-name",
            "text": "河豚"
        }
    },
    {
        "id": "la-park_fishing_fish-0006-description",
        "data": {
            "id": "la-park_fishing_fish-0006-description",
            "text": "海中的拳击手，放出的强力一击足以粉碎贝壳，但若是用盐水煮一煮，更能引出其中浓厚的鲜味！肉质甘甜弹牙，能让老食客也吃得频频点头。"
        }
    },
    {
        "id": "la-park_fishing_fish-0006-name",
        "data": {
            "id": "la-park_fishing_fish-0006-name",
            "text": "虾蛄"
        }
    },
    {
        "id": "la-park_fishing_fish-0007-description",
        "data": {
            "id": "la-park_fishing_fish-0007-description",
            "text": "住在海里的星形生物。有些品种可作为小众的下酒珍味，滋味妙不可言。只有不会被外表唬住的美食家，才能尝到那丝充满海潮气息的鲜美！"
        }
    },
    {
        "id": "la-park_fishing_fish-0007-name",
        "data": {
            "id": "la-park_fishing_fish-0007-name",
            "text": "海星"
        }
    },
    {
        "id": "la-park_fishing_fish-0008-description",
        "data": {
            "id": "la-park_fishing_fish-0008-description",
            "text": "跃出海面，在岸上活蹦乱跳的表演者。大眼睛以及大嘴巴非常惹人怜爱，除了用鳃呼吸，更可以用皮肤呼吸，是呼吸的专家。"
        }
    },
    {
        "id": "la-park_fishing_fish-0008-name",
        "data": {
            "id": "la-park_fishing_fish-0008-name",
            "text": "弹涂鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0009-description",
        "data": {
            "id": "la-park_fishing_fish-0009-description",
            "text": "优雅起舞的身姿，正是水族馆中的小小偶像。长得有点像章鱼，但确实是水母。看着它可能会想起柚子醋的香味和脆弹的口感，但这个品种只可远观，不可入口哦！"
        }
    },
    {
        "id": "la-park_fishing_fish-0009-name",
        "data": {
            "id": "la-park_fishing_fish-0009-name",
            "text": "珍珠水母"
        }
    },
    {
        "id": "la-park_fishing_fish-0010-description",
        "data": {
            "id": "la-park_fishing_fish-0010-description",
            "text": "能从雌性华丽变身成雄性的水族馆之花。这家伙偷起鱼饵来得心又应手，拿去炖煮或酥炸清甜又适口。是渔获中隐藏的主角！"
        }
    },
    {
        "id": "la-park_fishing_fish-0010-name",
        "data": {
            "id": "la-park_fishing_fish-0010-name",
            "text": "隆头鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0011-description",
        "data": {
            "id": "la-park_fishing_fish-0011-description",
            "text": "别名“报春鱼”的鱼类之一，能够带来春天的讯息。炖煮后，鱼肉吸饱汤汁会变得蓬松柔软，让人一吃就停不下来。据说它还是个大近视，一反差显得更可爱了。"
        }
    },
    {
        "id": "la-park_fishing_fish-0011-name",
        "data": {
            "id": "la-park_fishing_fish-0011-name",
            "text": "眼张鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0012-description",
        "data": {
            "id": "la-park_fishing_fish-0012-description",
            "text": "在珊瑚丛中飞舞的身姿，就像是海中的蝴蝶。在部分地区曾经是家常的食用鱼，但现在作为观赏鱼的地位已不可撼动。"
        }
    },
    {
        "id": "la-park_fishing_fish-0012-name",
        "data": {
            "id": "la-park_fishing_fish-0012-name",
            "text": "耳带蝴蝶鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0013-description",
        "data": {
            "id": "la-park_fishing_fish-0013-description",
            "text": "常常被人当作是鲷鱼，但它属于金眼鲷科，跟鲷科并不一样。在被它金色的眼睛迷住之前下锅，就着炖鱼来杯小酒吧。多汁饱满的鱼肉一定会入口即化的！"
        }
    },
    {
        "id": "la-park_fishing_fish-0013-name",
        "data": {
            "id": "la-park_fishing_fish-0013-name",
            "text": "金目鲷"
        }
    },
    {
        "id": "la-park_fishing_fish-0014-description",
        "data": {
            "id": "la-park_fishing_fish-0014-description",
            "text": "遍染珊瑚礁的茜红体色，在名为鱼缸的舞台上发挥它真正的价值。作为南国的偶像，它鲜丽的色彩满足的并非胃袋，而是钓鱼人的心灵！"
        }
    },
    {
        "id": "la-park_fishing_fish-0014-name",
        "data": {
            "id": "la-park_fishing_fish-0014-name",
            "text": "黄尾拟花鲈"
        }
    },
    {
        "id": "la-park_fishing_fish-0015-description",
        "data": {
            "id": "la-park_fishing_fish-0015-description",
            "text": "别名“海中宝石”，实为形态百变的软体动物。那对神秘的触角加上色彩斑斓的身体，简直就像从异世界穿越来的角色！就算不能吃，也能强烈激发人的占有欲！"
        }
    },
    {
        "id": "la-park_fishing_fish-0015-name",
        "data": {
            "id": "la-park_fishing_fish-0015-name",
            "text": "海蛞蝓"
        }
    },
    {
        "id": "la-park_fishing_fish-0016-description",
        "data": {
            "id": "la-park_fishing_fish-0016-description",
            "text": "它在海底穿行，还能震动鱼鳔发出声响，正是海中的奇人异士。受到君主喜爱的趣闻非常出名，但它的真本事在于刺身的滋味！越是咀嚼，鲜味越溢于唇齿间，将你带上幸福的巅峰！"
        }
    },
    {
        "id": "la-park_fishing_fish-0016-name",
        "data": {
            "id": "la-park_fishing_fish-0016-name",
            "text": "绿鳍鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0017-description",
        "data": {
            "id": "la-park_fishing_fish-0017-description",
            "text": "无须多言的鱼界领袖。刺身口感弹牙，做成鲷鱼饭则有芳醇的香气，不论哪一项都是主角级的规格，为喜庆的宴席增添一抹色彩。"
        }
    },
    {
        "id": "la-park_fishing_fish-0017-name",
        "data": {
            "id": "la-park_fishing_fish-0017-name",
            "text": "鲷鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0018-description",
        "data": {
            "id": "la-park_fishing_fish-0018-description",
            "text": "因为唇下的两撇胡须像大叔，在日语中叫“大叔鱼”……但它的鲜味仿佛在说“别小看大叔啊”一样，在各种料理中表现不凡。为它横扫偏见的实力鼓掌！"
        }
    },
    {
        "id": "la-park_fishing_fish-0018-name",
        "data": {
            "id": "la-park_fishing_fish-0018-name",
            "text": "多带副绯鲤"
        }
    },
    {
        "id": "la-park_fishing_fish-0019-description",
        "data": {
            "id": "la-park_fishing_fish-0019-description",
            "text": "可爱地从沙子里探出小脑袋，俘获了万千粉丝的心。它们随波起舞的样子填满钓师们的心房，再高档的鱼相比之下都略显逊色。"
        }
    },
    {
        "id": "la-park_fishing_fish-0019-name",
        "data": {
            "id": "la-park_fishing_fish-0019-name",
            "text": "花园鳗"
        }
    },
    {
        "id": "la-park_fishing_fish-0020-description",
        "data": {
            "id": "la-park_fishing_fish-0020-description",
            "text": "它是惊人的时尚先锋，从迷惑天敌的漩涡纹迅速成长，一眨眼就换上了华丽的条纹。能满足观者的美学品味的它，就是最棒的视觉担当。"
        }
    },
    {
        "id": "la-park_fishing_fish-0020-name",
        "data": {
            "id": "la-park_fishing_fish-0020-name",
            "text": "漩涡刺盖鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0022-description",
        "data": {
            "id": "la-park_fishing_fish-0022-description",
            "text": "鲜亮的橙色和黑色纹路就像一团火焰。脸长得很可爱，但性格血气方刚，争夺地盘是家常便饭。光是看看它那烈焰般的光辉，就会感到热血沸腾！"
        }
    },
    {
        "id": "la-park_fishing_fish-0022-name",
        "data": {
            "id": "la-park_fishing_fish-0022-name",
            "text": "火焰神仙鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0023-description",
        "data": {
            "id": "la-park_fishing_fish-0023-description",
            "text": "2017年告别虚假的旧名，甩开“亚种”帽子，扬眉吐气列为新种！别以为它只能当观赏鱼，在部分地区，它可是炸着吃、煮着吃都美味得要命的“鱼中黑马”呢！"
        }
    },
    {
        "id": "la-park_fishing_fish-0023-name",
        "data": {
            "id": "la-park_fishing_fish-0023-name",
            "text": "发带光鳃鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0024-description",
        "data": {
            "id": "la-park_fishing_fish-0024-description",
            "text": "拥有不老传说的海中寿星。只需佐以大量蒜蓉烤熟，就能以它醇厚的虾膏和弹牙的虾肉牢牢抓住食客的心！全球吃了都说好。"
        }
    },
    {
        "id": "la-park_fishing_fish-0024-name",
        "data": {
            "id": "la-park_fishing_fish-0024-name",
            "text": "龙虾"
        }
    },
    {
        "id": "la-park_fishing_fish-0027-description",
        "data": {
            "id": "la-park_fishing_fish-0027-description",
            "text": "可爱的外形为它在水族馆中赢得了不可撼动的人气。在部分地区是深受喜爱的传统食材，看着治愈人心，吃着风味独特。一鱼二赏，堪称深海催生的奇迹。"
        }
    },
    {
        "id": "la-park_fishing_fish-0027-name",
        "data": {
            "id": "la-park_fishing_fish-0027-name",
            "text": "翻车鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0028-description",
        "data": {
            "id": "la-park_fishing_fish-0028-description",
            "text": "每个人都会向往能钓到一次的鱼。它会在海底行走，还会展开胸鳍惊吓对方，尽管行为模式犹如搞笑艺人，但它扇动大大的鱼鳍游泳的样子非常帅气。"
        }
    },
    {
        "id": "la-park_fishing_fish-0028-name",
        "data": {
            "id": "la-park_fishing_fish-0028-name",
            "text": "万人迷绿鳍鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0029-description",
        "data": {
            "id": "la-park_fishing_fish-0029-description",
            "text": "每个人都会向往能钓到一次的鱼。拥有极端发达的大脑，人称“鱼界智囊”。见到它优雅洄游的身姿，还有那双满溢着知性的眼睛，谁都会震撼到失语的。"
        }
    },
    {
        "id": "la-park_fishing_fish-0029-name",
        "data": {
            "id": "la-park_fishing_fish-0029-name",
            "text": "学究魔鬼鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0030-description",
        "data": {
            "id": "la-park_fishing_fish-0030-description",
            "text": "拥有鲜艳体色的奢华龙虾，是钓师们的憧憬。平时的气质就仿佛上流名媛，可一旦受到惊吓就会蜷起身体往后飞退的“怪相”，又让人忍俊不禁。"
        }
    },
    {
        "id": "la-park_fishing_fish-0030-name",
        "data": {
            "id": "la-park_fishing_fish-0030-name",
            "text": "卡哇伊势龙虾"
        }
    },
    {
        "id": "la-park_fishing_fish-0034-description",
        "data": {
            "id": "la-park_fishing_fish-0034-description",
            "text": "人们对它总有“曾得到将军嘉许”的高贵印象，但它其实是在严苛环境里拼命讨生活的庶民。冬天将钓上来的鲜货裹粉炸至金黄酥脆，一口下去就是高档料理也敌不过的奢侈！"
        }
    },
    {
        "id": "la-park_fishing_fish-0034-name",
        "data": {
            "id": "la-park_fishing_fish-0034-name",
            "text": "西太公鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0035-description",
        "data": {
            "id": "la-park_fishing_fish-0035-description",
            "text": "名为“秋日之刀”的银亮洄游鱼。在屋檐下摆好炭炉后，它躺在烤网上“滋滋”作响的声音，就是秋天到来的信号。做成刺身入口即化，上炉烤制则香气扑鼻，是寻常人家的好伙伴！"
        }
    },
    {
        "id": "la-park_fishing_fish-0035-name",
        "data": {
            "id": "la-park_fishing_fish-0035-name",
            "text": "秋刀鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0036-description",
        "data": {
            "id": "la-park_fishing_fish-0036-description",
            "text": "别名“报春鱼”的鱼类之一，是海中的信使。金色的光辉非常吉利，带来浓烈的春日气息。把它做成甘露煮，放在荞麦面上，庆贺终于熬过了漫长的冬天吧！"
        }
    },
    {
        "id": "la-park_fishing_fish-0036-name",
        "data": {
            "id": "la-park_fishing_fish-0036-name",
            "text": "鲱鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0037-description",
        "data": {
            "id": "la-park_fishing_fish-0037-description",
            "text": "人称海岸线上的蓝色奇迹，实际上是非常下酒的超级实力派。不论是用酱油腌制的经典做法，还是拌上醋味噌，那浓缩的海潮气息都会直冲鼻腔，俘虏你的胃！"
        }
    },
    {
        "id": "la-park_fishing_fish-0037-name",
        "data": {
            "id": "la-park_fishing_fish-0037-name",
            "text": "萤乌贼"
        }
    },
    {
        "id": "la-park_fishing_fish-0038-description",
        "data": {
            "id": "la-park_fishing_fish-0038-description",
            "text": "挥舞着钳子跳起求偶舞的海中艺人。整只下锅红彤彤地煮熟固然鲜美，用来烫火锅也是难以割舍的选择！大快朵颐到最后再下一把大米，把粥水也喝得一滴不剩吧！"
        }
    },
    {
        "id": "la-park_fishing_fish-0038-name",
        "data": {
            "id": "la-park_fishing_fish-0038-name",
            "text": "螃蟹"
        }
    },
    {
        "id": "la-park_fishing_fish-0039-description",
        "data": {
            "id": "la-park_fishing_fish-0039-description",
            "text": "象征着长寿和辟邪的喜庆生物。多加胡椒十分下饭，裹粉油炸则口感爽脆。总之一口气吃个精光，让幸运值暴涨吧！"
        }
    },
    {
        "id": "la-park_fishing_fish-0039-name",
        "data": {
            "id": "la-park_fishing_fish-0039-name",
            "text": "虾"
        }
    },
    {
        "id": "la-park_fishing_fish-0040-description",
        "data": {
            "id": "la-park_fishing_fish-0040-description",
            "text": "身覆漆黑的尖刺铠甲，放任不管能把海藻全吃光的海中大胃王！待它被海藻喂胖后取出内容物，盖在饭上大口猛扒，海潮的香气和迸发的甘甜就会轰炸你的味蕾啦！"
        }
    },
    {
        "id": "la-park_fishing_fish-0040-name",
        "data": {
            "id": "la-park_fishing_fish-0040-name",
            "text": "海胆"
        }
    },
    {
        "id": "la-park_fishing_fish-0041-description",
        "data": {
            "id": "la-park_fishing_fish-0041-description",
            "text": "不仅长得可怕，身上的刺更有剧毒，但去掉这些伪装，就会露出底下雪白的鱼肉。如果裹粉油炸，连骨头都能嚼碎吞下去，嘴里的咸香鲜味更是大爆发！"
        }
    },
    {
        "id": "la-park_fishing_fish-0041-name",
        "data": {
            "id": "la-park_fishing_fish-0041-name",
            "text": "老虎鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0042-description",
        "data": {
            "id": "la-park_fishing_fish-0042-description",
            "text": "潜伏在沙中，一击干掉猎物的精湛猎手。将它那像猎人一样紧实有力的身躯切成薄片，再佐以辣味萝卜泥，一定能击穿你的味觉！"
        }
    },
    {
        "id": "la-park_fishing_fish-0042-name",
        "data": {
            "id": "la-park_fishing_fish-0042-name",
            "text": "比目鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0043-description",
        "data": {
            "id": "la-park_fishing_fish-0043-description",
            "text": "潜伏在平静海底的沙子中，等候时机。正是这无与伦比的耐性，养育出了结实弹牙的绝佳身躯。以滋味浓厚的汤汁炖煮后令人吃不停筷，正可谓是煮鱼界之王者！"
        }
    },
    {
        "id": "la-park_fishing_fish-0043-name",
        "data": {
            "id": "la-park_fishing_fish-0043-name",
            "text": "鲽鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0044-description",
        "data": {
            "id": "la-park_fishing_fish-0044-description",
            "text": "在冻结的海洋中熠熠生辉的活水晶。无色透明的血液撩拨着每个人的好奇心。只要钓到一次，就一定会拜倒在它的神秘之下！"
        }
    },
    {
        "id": "la-park_fishing_fish-0044-name",
        "data": {
            "id": "la-park_fishing_fish-0044-name",
            "text": "南极冰鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0045-description",
        "data": {
            "id": "la-park_fishing_fish-0045-description",
            "text": "别名“花鱼”听着十分可爱，但如果用萝卜泥搭配在岩石滩附近吃得肥肥的它们，保准让你疯狂吸入米饭！正可谓是北境的实力派，在小酒馆也霸占必吃榜！"
        }
    },
    {
        "id": "la-park_fishing_fish-0045-name",
        "data": {
            "id": "la-park_fishing_fish-0045-name",
            "text": "远东多线鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0046-description",
        "data": {
            "id": "la-park_fishing_fish-0046-description",
            "text": "外表像锋利的长刀，内里却油脂丰润，堪称白肉鱼中的王子！可以烤得香香脆脆，也可以用黄油炒成西洋风味，刀光一闪，直取你的味蕾！"
        }
    },
    {
        "id": "la-park_fishing_fish-0046-name",
        "data": {
            "id": "la-park_fishing_fish-0046-name",
            "text": "高鳍带鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0047-description",
        "data": {
            "id": "la-park_fishing_fish-0047-description",
            "text": "委身于海浪，终日随波逐流的琉璃艺术品。它在水族馆的灯光下翩翩起舞的样子，一定能给你提供最深层的治愈。"
        }
    },
    {
        "id": "la-park_fishing_fish-0047-name",
        "data": {
            "id": "la-park_fishing_fish-0047-name",
            "text": "海月水母"
        }
    },
    {
        "id": "la-park_fishing_fish-0048-description",
        "data": {
            "id": "la-park_fishing_fish-0048-description",
            "text": "虽然挂着“帝王”之名，在日本却有“鳟之助”这种像武士一样的别称。切厚片配上黄油香煎，汹涌而出的油脂能将你的舌头一刀两断！"
        }
    },
    {
        "id": "la-park_fishing_fish-0048-name",
        "data": {
            "id": "la-park_fishing_fish-0048-name",
            "text": "帝王鲑"
        }
    },
    {
        "id": "la-park_fishing_fish-0049-description",
        "data": {
            "id": "la-park_fishing_fish-0049-description",
            "text": "长得不起眼，个子也大，却是号称“全身皆鱼腩”的深海大油桶！夹起一片送入口中，过于浓厚的油脂就会在嘴里引发大爆炸。一定要记得别一次吃太多了！"
        }
    },
    {
        "id": "la-park_fishing_fish-0049-name",
        "data": {
            "id": "la-park_fishing_fish-0049-name",
            "text": "白斑光裸头鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0050-description",
        "data": {
            "id": "la-park_fishing_fish-0050-description",
            "text": "在水中摇摇曳曳，直立漂游的姿态，在水族馆也是人气高位。雌性会将新生命托付给雄性养育，注入爱意。长年以来一直是海底的现役奶爸！"
        }
    },
    {
        "id": "la-park_fishing_fish-0050-name",
        "data": {
            "id": "la-park_fishing_fish-0050-name",
            "text": "海马"
        }
    },
    {
        "id": "la-park_fishing_fish-0051-description",
        "data": {
            "id": "la-park_fishing_fish-0051-description",
            "text": "体型庞大，时速却能超过100千米的飙速狂魔！要是被撞到很可能痛到归西，但它从脸颊到腹部没有一寸不是宝，正可谓是美食的顶点！"
        }
    },
    {
        "id": "la-park_fishing_fish-0051-name",
        "data": {
            "id": "la-park_fishing_fish-0051-name",
            "text": "金枪鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0052-description",
        "data": {
            "id": "la-park_fishing_fish-0052-description",
            "text": "活在深邃的黑暗里，扁平又神秘。生来在深海活动，因此有些怕光，躯体也相当脆弱。如果奇迹让你有幸见到它，就把那种梦幻缥缈的美深深烙印在眼底吧！"
        }
    },
    {
        "id": "la-park_fishing_fish-0052-name",
        "data": {
            "id": "la-park_fishing_fish-0052-name",
            "text": "扁面蛸"
        }
    },
    {
        "id": "la-park_fishing_fish-0054-description",
        "data": {
            "id": "la-park_fishing_fish-0054-description",
            "text": "跨越5亿年的时光，从深海浮出水面的活化石。相比活过漫长岁月的它们，不禁令人深感人类的历史实在是弹指一挥间。"
        }
    },
    {
        "id": "la-park_fishing_fish-0054-name",
        "data": {
            "id": "la-park_fishing_fish-0054-name",
            "text": "鹦鹉螺"
        }
    },
    {
        "id": "la-park_fishing_fish-0055-description",
        "data": {
            "id": "la-park_fishing_fish-0055-description",
            "text": "海中的黑帮。谁敢闯入它的地盘，哪怕是人类也照揍不误。虽然这种鱼抓捕和处理都很麻烦，但一旦送入油锅，接下来等待你的就是珍奇的美食体验了！"
        }
    },
    {
        "id": "la-park_fishing_fish-0055-name",
        "data": {
            "id": "la-park_fishing_fish-0055-name",
            "text": "裸胸鳝"
        }
    },
    {
        "id": "la-park_fishing_fish-0056-description",
        "data": {
            "id": "la-park_fishing_fish-0056-description",
            "text": "别名“龙宫使者”的银色带子，散发着鱼如其名的神圣气场。体长最大可达8米，美得就像都市传说！它可是相当罕见的角色，试着从静寂的深海找到它吧！"
        }
    },
    {
        "id": "la-park_fishing_fish-0056-name",
        "data": {
            "id": "la-park_fishing_fish-0056-name",
            "text": "皇带鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0057-description",
        "data": {
            "id": "la-park_fishing_fish-0057-description",
            "text": "从漆黑的海域浮出水面，长达18米的巨大躯体犹如神话。但它的寿命竟然只有短暂的3年，真是梦幻泡影啊！如果运气好见到了它，就温和地跟它说一声“辛苦了”吧！"
        }
    },
    {
        "id": "la-park_fishing_fish-0057-name",
        "data": {
            "id": "la-park_fishing_fish-0057-name",
            "text": "大王乌贼"
        }
    },
    {
        "id": "la-park_fishing_fish-0060-description",
        "data": {
            "id": "la-park_fishing_fish-0060-description",
            "text": "名字就叫“巨口”，再加上最大可达7米的体长，更助长了那张大嘴的恐怖。但它的生态至今仍然蒙着一层神秘的面纱。要是钓到它，可要第一时间联系相关人士啊！"
        }
    },
    {
        "id": "la-park_fishing_fish-0060-name",
        "data": {
            "id": "la-park_fishing_fish-0060-name",
            "text": "巨口鲨"
        }
    },
    {
        "id": "la-park_fishing_fish-0061-description",
        "data": {
            "id": "la-park_fishing_fish-0061-description",
            "text": "钓师们心中向往的鱼。那美丽的身姿就像冰雪妖精一样，但它的性子其实非常活泼。要是被它看见谁呆站在原地犯傻，它可是会用触手毫不留情地“突”你一“槽”，要注意哦。"
        }
    },
    {
        "id": "la-park_fishing_fish-0061-name",
        "data": {
            "id": "la-park_fishing_fish-0061-name",
            "text": "雪花海天使"
        }
    },
    {
        "id": "la-park_fishing_fish-0062-description",
        "data": {
            "id": "la-park_fishing_fish-0062-description",
            "text": "每个人都会向往能钓到一次的鱼，特征是那副性感红唇和可爱的图案。脑袋上长得像海盗帽的部分到底能不能摘下来，是渔夫们经常争论的话题。"
        }
    },
    {
        "id": "la-park_fishing_fish-0062-name",
        "data": {
            "id": "la-park_fishing_fish-0062-name",
            "text": "妩媚阿波鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0063-description",
        "data": {
            "id": "la-park_fishing_fish-0063-description",
            "text": "每个人都会向往能钓到一次的鱼。名字叫“鼠目”，甚至长着老鼠耳朵，但又的的确确是鱼。身体长得像沙尖鱼，二者却没半点亲戚关系，或许这就是“混沌”的体现吧。"
        }
    },
    {
        "id": "la-park_fishing_fish-0063-name",
        "data": {
            "id": "la-park_fishing_fish-0063-name",
            "text": "鼠目沙钻鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0067-description",
        "data": {
            "id": "la-park_fishing_fish-0067-description",
            "text": "拥有“狼”的异名，如果以为它只是个头大点的竹䇲鱼就小看它，之后绝对会被它的强悍惊掉下巴。在与它一番缠斗之后品尝到的胜利滋味，品质决不输给金枪鱼的大腩！"
        }
    },
    {
        "id": "la-park_fishing_fish-0067-name",
        "data": {
            "id": "la-park_fishing_fish-0067-name",
            "text": "大竹䇲鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0068-description",
        "data": {
            "id": "la-park_fishing_fish-0068-description",
            "text": "舍弃了鱼鳔，把点数全加在速度上的高速贵公子。狂风巨浪锤打出来的肉体被做成西京烧后，成就了他真正的价值。闻闻这股扑鼻的香气，你也可以加速猛冲啦！"
        }
    },
    {
        "id": "la-park_fishing_fish-0068-name",
        "data": {
            "id": "la-park_fishing_fish-0068-name",
            "text": "蓝点马鲛"
        }
    },
    {
        "id": "la-park_fishing_fish-0069-description",
        "data": {
            "id": "la-park_fishing_fish-0069-description",
            "text": "作为每个成长阶段都会更名的“出头鱼”，不停地攀浪登潮，抵达最高峰者还能获得特殊的名号。是刺身、香煎、炖煮都很好吃的百搭吉利鱼哦！"
        }
    },
    {
        "id": "la-park_fishing_fish-0069-name",
        "data": {
            "id": "la-park_fishing_fish-0069-name",
            "text": "海鲈鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0070-description",
        "data": {
            "id": "la-park_fishing_fish-0070-description",
            "text": "一瞬间进入时速40km的世界——从名为漏斗的器官中喷出的水，让它成为了海里的速度之星。吃过它透明的刺身后就被俘虏的钓师们，今天也在争先恐后地抛竿甩饵。"
        }
    },
    {
        "id": "la-park_fishing_fish-0070-name",
        "data": {
            "id": "la-park_fishing_fish-0070-name",
            "text": "莱氏拟乌贼"
        }
    },
    {
        "id": "la-park_fishing_fish-0071-description",
        "data": {
            "id": "la-park_fishing_fish-0071-description",
            "text": "掌控南方海域的猎人。味道很不错，但部分地区的品种可能带毒。莫非……就是这种危险和刺激，让它成为了只有勇敢者才能获得的禁忌美食？！"
        }
    },
    {
        "id": "la-park_fishing_fish-0071-name",
        "data": {
            "id": "la-park_fishing_fish-0071-name",
            "text": "尖吻龙占鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0072-description",
        "data": {
            "id": "la-park_fishing_fish-0072-description",
            "text": "别名“千针鱼”，顾名思义是身负千针、以此退敌的战士。但其实它铠甲上的刺只有大约400根，虚报这么多反而显得很可爱。如果见到它，不必说多余的话，默默全力支持就好！"
        }
    },
    {
        "id": "la-park_fishing_fish-0072-name",
        "data": {
            "id": "la-park_fishing_fish-0072-name",
            "text": "二齿鲀"
        }
    },
    {
        "id": "la-park_fishing_fish-0073-description",
        "data": {
            "id": "la-park_fishing_fish-0073-description",
            "text": "像南国挂饰般美丽的长角是它的招牌。据说它有开运的功效，是很受欢迎的观赏鱼！想必养了它一定能让心中充满希望！"
        }
    },
    {
        "id": "la-park_fishing_fish-0073-name",
        "data": {
            "id": "la-park_fishing_fish-0073-name",
            "text": "镰鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0074-description",
        "data": {
            "id": "la-park_fishing_fish-0074-description",
            "text": "优雅地展开鱼鳍，像海中盛放的花朵一般让人为它着迷。但它美丽的鱼鳍中潜藏着毒针，任何胆敢贸然接近它的莽夫，都只会得到死神的拥抱作为赠礼。"
        }
    },
    {
        "id": "la-park_fishing_fish-0074-name",
        "data": {
            "id": "la-park_fishing_fish-0074-name",
            "text": "翱翔蓑鲉"
        }
    },
    {
        "id": "la-park_fishing_fish-0075-description",
        "data": {
            "id": "la-park_fishing_fish-0075-description",
            "text": "独特的外形让它得了“团扇”这个亲民的称呼，实际可是肉质匹敌伊势龙虾的高档甲壳动物！如果将它奢侈地做成刺身，或者放进味噌汤炖煮，它就会用鲜美的表现改写你对美食的认知！"
        }
    },
    {
        "id": "la-park_fishing_fish-0075-name",
        "data": {
            "id": "la-park_fishing_fish-0075-name",
            "text": "团扇虾"
        }
    },
    {
        "id": "la-park_fishing_fish-0076-description",
        "data": {
            "id": "la-park_fishing_fish-0076-description",
            "text": "本以为它鱼如其名一黑到底，结果情绪激动时不但会变白，尾鳍上还有一抹鲜艳的粉红做点缀！可谓是藏在“黑”之名下的百变时尚家！"
        }
    },
    {
        "id": "la-park_fishing_fish-0076-name",
        "data": {
            "id": "la-park_fishing_fish-0076-name",
            "text": "黑边角鳞鲀"
        }
    },
    {
        "id": "la-park_fishing_fish-0077-description",
        "data": {
            "id": "la-park_fishing_fish-0077-description",
            "text": "从深海被拉上海面时，它的眼睛会膨出，所以在日本也叫“凸眼鱼”。它的肉质在深海已经完成了熟成，算是高档鱼类。实在钓不到，就去高端料亭里品尝吧！"
        }
    },
    {
        "id": "la-park_fishing_fish-0077-name",
        "data": {
            "id": "la-park_fishing_fish-0077-name",
            "text": "松原平鲉"
        }
    },
    {
        "id": "la-park_fishing_fish-0078-description",
        "data": {
            "id": "la-park_fishing_fish-0078-description",
            "text": "它拉扯的力道之大，足以点燃钓师的斗志。因为各地称呼不一，叫起来有些混淆，但它的味道是无可挑剔的特级！不管是做成刺身还是寿司，都会给你的味蕾来上重重一拳！"
        }
    },
    {
        "id": "la-park_fishing_fish-0078-name",
        "data": {
            "id": "la-park_fishing_fish-0078-name",
            "text": "红甘鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0079-description",
        "data": {
            "id": "la-park_fishing_fish-0079-description",
            "text": "用稻草点火炙烧，再配上一大堆姜丝或茗荷送入口中，就能体会到曾经的江户人民深爱的好滋味！而且它的肉高蛋白低脂肪，含有丰富的铁，想补充精力，就要切得厚厚的！"
        }
    },
    {
        "id": "la-park_fishing_fish-0079-name",
        "data": {
            "id": "la-park_fishing_fish-0079-name",
            "text": "鲣鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0080-description",
        "data": {
            "id": "la-park_fishing_fish-0080-description",
            "text": "从肃杀的寒冬海中钓上来的“青甘鱼”。先涮过热腾腾的高汤，再蘸上柚子醋一同入口，那破坏力能直接杀死规则！一口气吃完这象征着幸运的鱼，接下来肯定会好事连连啦！"
        }
    },
    {
        "id": "la-park_fishing_fish-0080-name",
        "data": {
            "id": "la-park_fishing_fish-0080-name",
            "text": "油甘鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0081-description",
        "data": {
            "id": "la-park_fishing_fish-0081-description",
            "text": "用长长的嘴吸入猎物的样子，就像吹小号的爵士乐手。会拟态也会躲在大型鱼身后的它，今天也享受着仿佛在爵士乐吧即兴演奏的生活。"
        }
    },
    {
        "id": "la-park_fishing_fish-0081-name",
        "data": {
            "id": "la-park_fishing_fish-0081-name",
            "text": "管口鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0082-description",
        "data": {
            "id": "la-park_fishing_fish-0082-description",
            "text": "它是躲藏在昏暗岩礁深处的巨影。市面上流通量极少，被称作梦幻之鱼。富含胶质的白肉之美味甚至凌驾于河豚之上，先烫火锅，最后再把汤底煮成粥，能掀翻你的味觉常识！"
        }
    },
    {
        "id": "la-park_fishing_fish-0082-name",
        "data": {
            "id": "la-park_fishing_fish-0082-name",
            "text": "褐石斑鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0083-description",
        "data": {
            "id": "la-park_fishing_fish-0083-description",
            "text": "拥有“深海清洁工”的别号，就像生活在海底的巨型西瓜虫。据说它曾创下绝食近5年的纪录，可谓是相当“节能”的生活方式了。如果有幸见到它，不妨虔诚拜见一下它那超然物外的姿态吧！"
        }
    },
    {
        "id": "la-park_fishing_fish-0083-name",
        "data": {
            "id": "la-park_fishing_fish-0083-name",
            "text": "大王具足虫"
        }
    },
    {
        "id": "la-park_fishing_fish-0085-description",
        "data": {
            "id": "la-park_fishing_fish-0085-description",
            "text": "会依偎在大鱼身边的鲹形目，不但借此混到饭吃，连“鲨鱼”的名头都混上了。做刺身、做烤鱼都油脂丰富、鲜味爆棚，在部分钓师之中很受好评！"
        }
    },
    {
        "id": "la-park_fishing_fish-0085-name",
        "data": {
            "id": "la-park_fishing_fish-0085-name",
            "text": "吸盘鲨"
        }
    },
    {
        "id": "la-park_fishing_fish-0086-description",
        "data": {
            "id": "la-park_fishing_fish-0086-description",
            "text": "鱼类和爬虫类中都有名为“海蛇”的生物。一部分鱼类海蛇（蛇鳗）可以吃，爬虫类海蛇在部分地区也是高级药膳，但它们通常有毒，食用一定要小心！简直就是潜伏在海里的禁果！"
        }
    },
    {
        "id": "la-park_fishing_fish-0086-name",
        "data": {
            "id": "la-park_fishing_fish-0086-name",
            "text": "海蛇"
        }
    },
    {
        "id": "la-park_fishing_fish-0088-description",
        "data": {
            "id": "la-park_fishing_fish-0088-description",
            "text": "大约2米的体长加上50km的时速，称得上“海中火箭”。在海里哪怕碰上人类也只是冷冷地看着，贸然对抗还有中毒的风险……这家伙，浑身上下都充满了刺激！"
        }
    },
    {
        "id": "la-park_fishing_fish-0088-name",
        "data": {
            "id": "la-park_fishing_fish-0088-name",
            "text": "巴拉金梭鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0089-description",
        "data": {
            "id": "la-park_fishing_fish-0089-description",
            "text": "它总是扇动巨大的“斗篷”，在广阔的海洋中遨游。部分地区会吃这种鱼，两翼鱼鳍尤为受欢迎。据说裹粉做成炸鱼块的话，口感类似鸡肉。"
        }
    },
    {
        "id": "la-park_fishing_fish-0089-name",
        "data": {
            "id": "la-park_fishing_fish-0089-name",
            "text": "魔鬼鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-0091-description",
        "data": {
            "id": "la-park_fishing_fish-0091-description",
            "text": "别致的锤子型脑袋看起来蠢萌可爱，但其实功能多多。它能感知到海水的搏动甚至于微弱的电流。而且挂面糊或裹粉炸都十分美味，甚至还能做成鱼糕，在食材方面也是高性能呢！"
        }
    },
    {
        "id": "la-park_fishing_fish-0091-name",
        "data": {
            "id": "la-park_fishing_fish-0091-name",
            "text": "锤头鲨"
        }
    },
    {
        "id": "la-park_fishing_fish-0093-description",
        "data": {
            "id": "la-park_fishing_fish-0093-description",
            "text": "全长能达到20米的世界最大鱼类。据说每一条身上的花纹都是独一无二的。看见它带着一群小鱼悠然游曳的样子，就会知道“海之王”的称号当之无愧。"
        }
    },
    {
        "id": "la-park_fishing_fish-0093-name",
        "data": {
            "id": "la-park_fishing_fish-0093-name",
            "text": "鲸鲨"
        }
    },
    {
        "id": "la-park_fishing_fish-0094-description",
        "data": {
            "id": "la-park_fishing_fish-0094-description",
            "text": "每个人都会向往能钓到一次的鱼。跟叉斑锉鳞鲀长得很像，但要调皮得多。喜欢恶作剧，是个叫人恨不起来的可爱小屁孩。"
        }
    },
    {
        "id": "la-park_fishing_fish-0094-name",
        "data": {
            "id": "la-park_fishing_fish-0094-name",
            "text": "暴雨叉斑锉鳞鲀"
        }
    },
    {
        "id": "la-park_fishing_fish-0095-description",
        "data": {
            "id": "la-park_fishing_fish-0095-description",
            "text": "这一带的钓师都很向往的鱼，身上有像手里剑一样的标记。特征是握力超过50kg的大钳子，是遇到猎物就会“嘎吱”一下狠狠夹住的恐怖海中大猩猩。"
        }
    },
    {
        "id": "la-park_fishing_fish-0095-name",
        "data": {
            "id": "la-park_fishing_fish-0095-name",
            "text": "天使锯青蟹"
        }
    },
    {
        "id": "la-park_fishing_fish-0096-description",
        "data": {
            "id": "la-park_fishing_fish-0096-description",
            "text": "钓师们向往的鱼。特征是像小丑的帽子一样华丽的头部。平时一般会拟态成沙石，时不时就会像大喊着“我在的哦～！”一样突然现身，让潜水员们不禁微笑。"
        }
    },
    {
        "id": "la-park_fishing_fish-0096-name",
        "data": {
            "id": "la-park_fishing_fish-0096-name",
            "text": "小丑安在青蛙鱼"
        }
    },
    {
        "id": "la-park_fishing_fish-item-facility-area_a03-002-1-description",
        "data": {
            "id": "la-park_fishing_fish-item-facility-area_a03-002-1-description",
            "text": "漂流金属"
        }
    },
    {
        "id": "la-park_fishing_fish-item-facility-area_a03-002-1-name",
        "data": {
            "id": "la-park_fishing_fish-item-facility-area_a03-002-1-name",
            "text": "漂流金属"
        }
    }
]